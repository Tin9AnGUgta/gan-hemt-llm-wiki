{
  "version": "1.1.0",
  "max_attempts_per_instance": 3,
  "max_automatic_repairs_per_run": 6,
  "nodes": [
    {"id":"G0","kind":"automatic","depends":[],"checks":["private_location","sources_readable","immutable_copies","page_counts","repository_configured"]},
    {"id":"G1","kind":"automatic","per_source":true,"depends":["G0"],"checks":["all_pages_registered","extraction_flags_recorded","equation_candidates_not_certified","formula_visual_risks_recorded"]},
    {"id":"G2","kind":"agent","per_source":true,"depends":["G1:{source}"],"checks":["source_locations","conditions_and_units","reading_scope_declared"]},
    {"id":"G3","kind":"agent","per_source":true,"depends":["G2:{source}"],"checks":["core_claims_checked","formula_status_transparent","uncertainty_recorded"]},
    {"id":"G4","kind":"agent","per_source":true,"depends":["G3:{source}"],"checks":["paper_template","four_evidence_labels","review_brief","remaining_work_declared"]},
    {"id":"H1","kind":"human","depends":["G4:*"],"checks":["main_paper_notes","major_equations_list"]},
    {"id":"G5","kind":"agent","depends":["H1"],"checks":["relative_links","comparison_conditions","contradictions_and_gaps"]},
    {"id":"H2","kind":"human","depends":["G5"],"checks":["cross_paper_integration"]},
    {"id":"G6","kind":"agent","depends":["H2"],"checks":["learning_objectives","prerequisite_order","slide_source_map"]},
    {"id":"H3","kind":"human","depends":["G6"],"checks":["teaching_outline"]},
    {"id":"G7","kind":"agent","depends":["H3"],"checks":["wiki_grounding","assets_registered","models_labeled"]},
    {"id":"G8","kind":"agent","depends":["G7"],"checks":["html_functions","math_and_images","visual_review","source_links"]},
    {"id":"G9","kind":"agent","depends":["G8"],"checks":["public_allowlist","rights_review","no_private_content","unresolved_items_excluded"]},
    {"id":"G10","kind":"agent","depends":["G9"],"checks":["public_url_verified","actual_run_report","evidence_based_reflection"]}
  ],
  "failure_routes": {
    "unreadable_page":"G1:{source}","unsupported_claim":"G2:{source}","wrong_formula":"G1:{source}",
    "wiki_structure":"G4:{source}","comparison_conditions":"G5","teaching_sequence":"G6",
    "html_layout":"G7","missing_wiki_evidence":"G4:{source}","rights_unknown":"blocked"
  }
}
